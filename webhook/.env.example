# --- Webhook server settings ---
PORT=9000
WEBHOOK_SECRET=change-me-to-a-long-random-string
REPO_FULL_NAME=owner/repo
REPO_BRANCH=main

# Path on the HOST where the app repo lives (used in docker-compose volume mount)
# The webhook mounts this at the same path inside the container so Docker bind
# mounts in the app compose resolve correctly through /var/run/docker.sock.
HOST_REPO_DIR=/opt/hippio

# Optional: host SSH directory used only for outbound Git pulls, not deployment
HOST_SSH_DIR=~/.ssh
